# Optional role addresses (EOA or future multisig). Defaults to --account teamKey sender.
# Do NOT put private keys here — Foundry uses encrypted keystore:
#   cast wallet list
#   forge script ... --account teamKey --broadcast
#
# TREASURY_OWNER = Ownable of the Treasury contract (fee withdraw).
# GUARDIAN       = Ownable of CDPManager (pause / unpause).
# TREASURY_OWNER=0x
# GUARDIAN=0x

# Optional RPC override (foundry.toml already has Monad testnet).
# ETH_RPC_URL=https://testnet-rpc.monad.xyz
